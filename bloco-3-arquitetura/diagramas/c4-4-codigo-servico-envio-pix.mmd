%% titulo: C4 nível 4 · Código do componente crítico ServicoEnvioPix
classDiagram
    direction LR
    class ServicoEnvioPix {
        -uow: UnidadeDeTrabalho
        -antifraude: MotorAntifraude
        -banco: PortaBancaria
        +iniciar(contaId: UUID, pedido: PedidoPix, chaveIdempotencia: String) Transacao
        +confirmarRetorno(idParceiro: String, aceito: Boolean) void
        -reservarSaldo(t: Transacao) void
        -compensar(t: Transacao) void
    }
    class UnidadeDeTrabalho {
        +executar~T~(trabalho: Funcao~T~) T
    }
    class TransacaoRepository {
        <<interface>>
        +buscarPorIdempotencia(contaId: UUID, chave: String) Transacao
        +salvar(t: Transacao) void
    }
    class LancamentoRepository {
        <<interface>>
        +lancar(transacaoId: UUID, partidas: List~Partida~) void
        +saldo(carteiraId: UUID) Long
    }
    class OutboxRepository {
        <<interface>>
        +publicar(tipo: String, agregadoId: UUID, payload: Json) void
    }
    class MotorAntifraude {
        -regras: List~RegraRisco~
        +avaliar(t: PixEnvio) AnaliseRisco
    }
    class RegraRisco {
        <<interface>>
        +pontuar(t: PixEnvio, h: HistoricoCliente) Integer
    }
    class RegraDestinatarioNovo {
        +pontuar(t: PixEnvio, h: HistoricoCliente) Integer
    }
    class RegraHorarioNoturno {
        +pontuar(t: PixEnvio, h: HistoricoCliente) Integer
    }
    class RegraValorForaDoPadrao {
        +pontuar(t: PixEnvio, h: HistoricoCliente) Integer
    }
    class PortaBancaria {
        <<interface>>
        +consultarChave(chave: String) DadosRecebedor
        +enviarPix(t: PixEnvio) RespostaParceiro
        +pagarBoleto(b: PagamentoBoleto) RespostaParceiro
    }
    class AdaptadorBaasHttp {
        -cliente: ClienteHttp
        -disjuntor: CircuitBreaker
        +consultarChave(chave: String) DadosRecebedor
        +enviarPix(t: PixEnvio) RespostaParceiro
        +pagarBoleto(b: PagamentoBoleto) RespostaParceiro
    }
    class Transacao {
        <<abstract>>
        #id: UUID
        #contaId: UUID
        #valorCentavos: Long
        #status: StatusTransacao
        #chaveIdempotencia: String
        +transicionarPara(novo: StatusTransacao) void
    }
    class PixEnvio {
        +chaveDestino: String
        +nomeRecebedor: String
        +bancoRecebedor: String
        +destinatarioNovo: Boolean
    }
    class StatusTransacao {
        <<enumeration>>
        PENDENTE
        RETIDA
        ENVIADA
        CONCLUIDA
        RECUSADA
        ESTORNADA
    }
    class AnaliseRisco {
        +nota: Integer
        +motivos: List~String~
        +resultado: ResultadoAnalise
    }

    ServicoEnvioPix --> UnidadeDeTrabalho
    ServicoEnvioPix --> MotorAntifraude
    ServicoEnvioPix --> PortaBancaria
    ServicoEnvioPix ..> TransacaoRepository : usa via uow
    ServicoEnvioPix ..> LancamentoRepository : usa via uow
    ServicoEnvioPix ..> OutboxRepository : usa via uow
    MotorAntifraude o-- "1..*" RegraRisco
    RegraRisco <|.. RegraDestinatarioNovo
    RegraRisco <|.. RegraHorarioNoturno
    RegraRisco <|.. RegraValorForaDoPadrao
    MotorAntifraude ..> AnaliseRisco : cria
    PortaBancaria <|.. AdaptadorBaasHttp
    Transacao <|-- PixEnvio
    Transacao --> StatusTransacao
    ServicoEnvioPix ..> PixEnvio : cria
