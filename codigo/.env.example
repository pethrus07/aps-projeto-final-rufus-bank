# =============================================================================
# Rufus Bank · variáveis de ambiente
# Copie para .env (cp .env.example .env). O .env NUNCA vai para o git.
# Em homologação e produção estes valores vêm do AWS Secrets Manager e das
# definições de tarefa do ECS, nunca de arquivo (Bloco 6, segurança).
# Explicação de cada variável: bloco-8-dev/02-variaveis-de-ambiente.md
# =============================================================================

# --- Geral -------------------------------------------------------------------
# desenvolvimento | teste | homologacao | producao
NODE_ENV=desenvolvimento
# Porta HTTP da API dentro do container
PORTA=3000
# trace | debug | info | warn | error
LOG_NIVEL=debug
# Versão mostrada em /health (o pipeline preenche com o hash do commit)
VERSAO=dev

# --- Banco de dados (PostgreSQL 17) ------------------------------------------
# Usadas pelo container do PostgreSQL no docker compose
POSTGRES_DB=rufus
POSTGRES_USER=rufus
POSTGRES_PASSWORD=rufus_local
# Conexão da API e do worker. "banco" é o nome do serviço no docker-compose.yml
# Rodando a API fora do Docker (npm run dev:api), troque banco por localhost
DATABASE_URL=postgres://rufus:rufus_local@banco:5432/rufus

# --- Autenticação (ADR-010) --------------------------------------------------
# Segredo de assinatura do JWT. No local qualquer texto longo serve.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SEGREDO=troque-por-um-segredo-local-com-mais-de-32-caracteres
# Validade do token de acesso e do token de renovação (RNF05)
JWT_ACESSO_MINUTOS=15
JWT_RENOVACAO_DIAS=30
# Tentativas de senha antes do bloqueio e duração do bloqueio (RF004)
LOGIN_TENTATIVAS_MAX=5
LOGIN_BLOQUEIO_MINUTOS=30

# --- Cifra de dados pessoais (RNF07) -----------------------------------------
# Chave de 32 bytes em base64 para cifrar CPF e data de nascimento.
# Em produção: chave de dados do AWS KMS. No local: qualquer chave gerada.
CHAVE_CIFRA_PII=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Outbox e worker (ADR-008) -----------------------------------------------
# Intervalo entre leituras do outbox e tamanho do lote
OUTBOX_INTERVALO_MS=1000
OUTBOX_LOTE=50

# --- Parceiro BaaS (ADR-002) -------------------------------------------------
# falso = adaptador em memória, sem rede (padrão do desenvolvimento)
# http  = adaptador real do parceiro contratado
BAAS_ADAPTADOR=falso
BAAS_URL=
BAAS_CLIENT_ID=
BAAS_CLIENT_SECRET=
# Segredo para conferir a assinatura HMAC de POST /v1/webhooks/baas
BAAS_WEBHOOK_SEGREDO=segredo-local-do-webhook
# Tempo máximo de espera de uma chamada ao parceiro (RNF02: Pix em até 10 s)
BAAS_TIMEOUT_MS=8000

# --- Voz (ADR-011) -----------------------------------------------------------
# falso = devolve um áudio de silêncio local; polly = Amazon Polly
VOZ_ADAPTADOR=falso
AWS_REGION=sa-east-1
S3_BUCKET_AUDIOS=rufus-audios-local

# --- Notificações ------------------------------------------------------------
# falso = só registra no log; expo = Expo Push
PUSH_ADAPTADOR=falso
EXPO_ACCESS_TOKEN=

# --- Painéis internos (ADR-012) ----------------------------------------------
# Emissor mostrado no app autenticador dos funcionários (TOTP)
TOTP_EMISSOR=Rufus Bank (local)
