{
  "family": "rufus-hml-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${CONTA}:role/rufus-hml-execucao",
  "taskRoleArn": "arn:aws:iam::${CONTA}:role/rufus-hml-worker",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "${CONTA}.dkr.ecr.sa-east-1.amazonaws.com/rufus-worker:{{TAG}}",
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "homologacao"
        },
        {
          "name": "SERVICO",
          "value": "rufus-worker"
        },
        {
          "name": "VERSAO",
          "value": "{{TAG}}"
        },
        {
          "name": "LOG_NIVEL",
          "value": "info"
        },
        {
          "name": "BAAS_ADAPTADOR",
          "value": "http"
        },
        {
          "name": "VOZ_ADAPTADOR",
          "value": "polly"
        },
        {
          "name": "PUSH_ADAPTADOR",
          "value": "expo"
        },
        {
          "name": "AWS_REGION",
          "value": "sa-east-1"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/database_url"
        },
        {
          "name": "JWT_SEGREDO",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/jwt_segredo"
        },
        {
          "name": "CHAVE_CIFRA_PII",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/chave_cifra_pii"
        },
        {
          "name": "BAAS_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/baas_client_id"
        },
        {
          "name": "BAAS_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/baas_client_secret"
        },
        {
          "name": "BAAS_WEBHOOK_SEGREDO",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/baas_webhook_segredo"
        },
        {
          "name": "EXPO_ACCESS_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:${CONTA}:secret:rufus-hml/expo_access_token"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/rufus-hml/worker",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "worker"
        }
      },
      "readonlyRootFilesystem": true,
      "user": "node"
    }
  ]
}
