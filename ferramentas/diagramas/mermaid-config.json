{
  "theme": "neutral",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "14px",
    "noteBkgColor": "#FFF8C5",
    "noteTextColor": "#111827",
    "noteBorderColor": "#C9A227"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "wrappingWidth": 330,
    "nodeSpacing": 40,
