%% titulo: Modelo lógico 2 de 3: contas, razão contábil e pagamentos
erDiagram
    conta {
        uuid id PK
        uuid cliente_id FK,UK
        text agencia
        text numero UK
        text id_conta_parceiro UK
        text status
        timestamptz bloqueada_em
        timestamptz criada_em
    }
    carteira {
        uuid id PK
        uuid conta_id FK
        text tipo
    }
    lancamento {
        uuid id PK
        uuid transacao_id FK
        uuid carteira_id FK
        bigint valor_centavos
        timestamptz criado_em
    }
    saldo_fechamento_diario {
        uuid carteira_id PK,FK
        date data PK
        bigint saldo_centavos
    }
    transacao {
        uuid id PK
        uuid conta_id FK
        text tipo
        bigint valor_centavos
        text status
        text chave_idempotencia
        text id_parceiro UK
        timestamptz criada_em
        timestamptz concluida_em
    }
    pix_envio {
        uuid transacao_id PK,FK
        text tipo
        text chave_destino
        text nome_recebedor
        text documento_recebedor_mascarado
        text banco_recebedor
        boolean destinatario_novo
    }
    pix_recebimento {
        uuid transacao_id PK,FK
        text tipo
        text nome_pagador
        text banco_pagador
    }
    pagamento_boleto {
        uuid transacao_id PK,FK
        text tipo
        text linha_digitavel
        text beneficiario
        date vencimento
        bigint juros_centavos
    }
    movimento_meta {
        uuid transacao_id PK,FK
        text tipo
        uuid meta_id FK
    }
    chave_pix {
        uuid id PK
        uuid conta_id FK
        text tipo
        text valor
        text status
        timestamptz criada_em
    }
    meta {
        uuid id PK
        uuid conta_id FK
        uuid carteira_id FK,UK
        text nome
        bigint valor_alvo_centavos
        date data_alvo
        text imagem_url
        text status
    }
    cliente {
        uuid id PK
    }
    cliente ||--o| conta : "cliente_id"
    conta |o--o{ carteira : "conta_id"
    transacao ||--o{ lancamento : "transacao_id"
    carteira ||--o{ lancamento : "carteira_id"
    carteira ||--o{ saldo_fechamento_diario : "carteira_id"
    conta ||--o{ transacao : "conta_id"
    transacao ||--o| pix_envio : "transacao_id"
    transacao ||--o| pix_recebimento : "transacao_id"
    transacao ||--o| pagamento_boleto : "transacao_id"
    meta ||--o{ movimento_meta : "meta_id"
    transacao ||--o| movimento_meta : "transacao_id"
    conta ||--o{ chave_pix : "conta_id"
    conta ||--o{ meta : "conta_id"
    carteira ||--o| meta : "carteira_id"
