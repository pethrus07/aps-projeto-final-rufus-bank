%% titulo: Modelo lógico 1 de 3: identidade, família e backoffice
erDiagram
    cliente {
        uuid id PK
        text nome_completo
        bytea cpf_cifrado
        char64 cpf_hash UK
        bytea data_nascimento_cifrada
        text celular
        text email
        text tipo
        text status
        timestamptz criado_em
    }
    dispositivo {
        uuid id PK
        uuid cliente_id FK
        text modelo
        text chave_publica UK
        boolean ativo
        timestamptz vinculado_em
    }
    credencial {
        uuid cliente_id PK,FK
        text hash_senha
        integer tentativas_erradas
        timestamptz bloqueada_ate
    }
    sessao_renovacao {
        uuid id PK
        uuid dispositivo_id FK
        char64 hash_token UK
        timestamptz expira_em
        timestamptz revogada_em
    }
    consentimento {
        uuid id PK
        uuid cliente_id FK
        text tipo
        text versao_termo
        timestamptz aceito_em
        uuid aceito_por_cliente_id FK
    }
    vinculo_responsavel {
        uuid id PK
        uuid menor_cliente_id FK,UK
        uuid responsavel_cliente_id FK
        text status
        bigint limite_diario_centavos
        bigint limite_mensal_centavos
        timestamptz convidado_em
        timestamptz aceito_em
        timestamptz expira_em
    }
    pedido_aprovacao {
        uuid id PK
        uuid vinculo_id FK
        uuid transacao_id FK,UK
        text status
        timestamptz criado_em
        timestamptz expira_em
        timestamptz decidido_em
    }
    contato_confianca {
        uuid id PK
        uuid cliente_id FK
        text nome
        text celular
        text status
        timestamptz aceito_em
    }
    funcionario {
        uuid id PK
        text nome
        text email
        text papel
        text hash_senha
        bytea segredo_totp_cifrado
        boolean ativo
    }
    registro_auditoria {
        bigint id PK
        uuid funcionario_id FK
        text acao
        text entidade
        text entidade_id
        inet ip
        timestamptz ocorrido_em
    }
    transacao {
        uuid id PK
    }
    cliente ||--o{ dispositivo : "cliente_id"
    cliente ||--o| credencial : "cliente_id"
    dispositivo ||--o{ sessao_renovacao : "dispositivo_id"
    cliente ||--o{ consentimento : "cliente_id"
    cliente ||--o{ consentimento : "aceito_por_cliente_id"
    cliente ||--o| vinculo_responsavel : "menor_cliente_id"
    cliente ||--o{ vinculo_responsavel : "responsavel_cliente_id"
    vinculo_responsavel ||--o{ pedido_aprovacao : "vinculo_id"
    transacao ||--o| pedido_aprovacao : "transacao_id"
    cliente ||--o{ contato_confianca : "cliente_id"
    funcionario ||--o{ registro_auditoria : "funcionario_id"
