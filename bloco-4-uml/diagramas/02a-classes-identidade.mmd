    }
    class ContatoConfianca {
        -id: UUID
        -nome: String
        -celular: String
        -status: StatusContato
        -aceitoEm: Instant
    }
    class Chamado {
        <<parte B>>
    }
    class Conta {
        <<parte C>>
    }
    class VinculoResponsavel {
        <<parte B>>
    }

    Cliente "1" *-- "1..*" Dispositivo : possui
